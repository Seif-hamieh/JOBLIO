# ── Core ─────────────────────────────────────────────────────────────────────
# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string. For local development without installing
# Postgres, run `npm run db:local` and paste the TCP URL it prints.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joblio

# ── Authentication (Better Auth) ────────────────────────────────────────────
# 32+ random bytes. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional). Create OAuth credentials at console.cloud.google.com
# and add  {BETTER_AUTH_URL}/api/auth/callback/google  as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in (optional social login).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# When SMTP_HOST is empty, emails (verification, password reset) are printed
# to the server console instead of being sent — handy for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="JOBLIO <no-reply@getjoblio.app>"

# ── Paddle (payments) ─────────────────────────
# Paddle is the merchant of record; card data never touches JOBLIO servers.
#   PADDLE_API_KEY         server only (Paddle > Developer tools > Authentication)
#   PADDLE_CLIENT_TOKEN    client-side token (starts with test_/live_); the server passes it to the browser
#   PADDLE_WEBHOOK_SECRET  secret of the notification destination for /api/webhooks/paddle
#   PADDLE_ENVIRONMENT     sandbox | production
# Without PADDLE_API_KEY, purchases are simulated outside production.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=

# Price IDs (Sandbox by default, replace for Live)
PADDLE_PRICE_FEATURED_JOB_7D=
PADDLE_PRICE_FEATURED_JOB_14D=
PADDLE_PRICE_FEATURED_JOB_30D=
PADDLE_PRICE_URGENT_HIRE_7D=
PADDLE_PRICE_URGENT_HIRE_14D=
PADDLE_PRICE_URGENT_HIRE_30D=
PADDLE_PRICE_PROFILE_BOOST_7D=
PADDLE_PRICE_PROFILE_BOOST_14D=
PADDLE_PRICE_PROFILE_BOOST_30D=
PADDLE_PRICE_PRIORITY_APPLICATION_1=
PADDLE_PRICE_PRIORITY_APPLICATION_5=
PADDLE_PRICE_PRIORITY_APPLICATION_10=
PADDLE_PRICE_JOB_SEEKER_PRO_MONTHLY=
PADDLE_PRICE_JOB_SEEKER_PRO_YEARLY=
PADDLE_PRICE_COMPANY_PREMIUM_MONTHLY=
PADDLE_PRICE_COMPANY_PREMIUM_YEARLY=
# Legacy single Featured Job price (30 days), used only while the three FEATURED_JOB_* prices above are empty.
PADDLE_PRICE_FEATURED_JOB=

# ── File uploads ────────────────────────────────────────────────────────────
# STORAGE_DRIVER:
#   local    — files under ./storage. Development only; does NOT work on Vercel.
#   supabase — Supabase Storage. Use this in production (Vercel).
STORAGE_DRIVER=local
# Vercel limits request bodies to 4.5 MB, so use 4194304 (4 MB) there.
UPLOAD_MAX_BYTES=10485760

# Supabase Storage (only read when STORAGE_DRIVER=supabase).
# Supabase dashboard → Project Settings → API: copy the Project URL and the
# service_role key. The service_role key is a server secret — never expose it
# with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for images (avatars, covers, logos, posts, projects).
SUPABASE_BUCKET=uploads
# Private bucket for CVs and message attachments, served through short-lived
# signed URLs. Defaults to "<SUPABASE_BUCKET>-private". Both buckets are
# created automatically on the first upload if they don't exist.
SUPABASE_PRIVATE_BUCKET=uploads-private

# --- Sentry (error monitoring) -------------------------------------------------
# Project DSN (Sentry > Project Settings > Client Keys). Public by design; empty = Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time (set on Vercel only; keep the token secret).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
