# ── Core ─────────────────────────────────────────────────────────────────────
# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string. For local development without installing
# Postgres, run `npm run db:local` and paste the TCP URL it prints.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joblio

# ── Authentication (Better Auth) ────────────────────────────────────────────
# 32+ random bytes. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional). Create OAuth credentials at console.cloud.google.com
# and add  {BETTER_AUTH_URL}/api/auth/callback/google  as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in (optional social login).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# When SMTP_HOST is empty, emails (verification, password reset) are printed
# to the server console instead of being sent — handy for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="JOBLIO <no-reply@joblio.com>"

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# Leave empty to disable checkout. Card data never touches JOBLIO servers:
# we redirect to Stripe Checkout and only store Stripe object IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development only: when "true" and NODE_ENV !== "production", purchases are
# fulfilled instantly without contacting Stripe so the premium flows can be
# demoed end-to-end. Ignored in production.
PAYMENTS_DEV_SIMULATE=true

# ── File uploads ────────────────────────────────────────────────────────────
# "local" stores files under ./storage (dev). Swap the driver in
# src/server/storage.ts for S3/R2 in production.
STORAGE_DRIVER=local
UPLOAD_MAX_BYTES=10485760
